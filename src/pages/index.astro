---
import BaseLayout from '../layouts/BaseLayout.astro';
import StitchDivider from '../components/StitchDivider.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import DefinitionBlock from '../components/DefinitionBlock.astro';
import { serviceSchema } from '../lib/schema';
import { targetQuarter } from '../lib/dates';
import { SITE, PERSON, CTA, ENGAGEMENTS } from '../consts';

const quarter = targetQuarter(); // ~4–5 months out, recomputed each build

// HOME — image-forward (full-bleed photos + text overlays), varied blocks,
// motion. Modeled on the structure of the current lsxpartners.com but in the
// new brand. Voice: Full LinkedIn Laura. Stats are her own sourced figures.
const marquee = ['ai visibility', 'get cited by ai', 'aeo', 'geo', 'audience intelligence', 'content activation'];
---
<BaseLayout title="LSX Partners — AI Visibility & Strategy" description={SITE.description} schemas={[serviceSchema()]}>
  <!-- HERO — text + a photo/sticker cluster -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="subhead">ai visibility &amp; strategy</p>
        <h1>Get cited by AI<span class="hero__h1-sub"> and bring leadership a plan they’ll approve</span></h1>
        <p class="hero__lede">
          You’ve had your team working on AI search for months, with stretch goals
          and side experiments stacked on top of their actual jobs. I come in, find
          out what AI really says about your brand and give you a direction you can
          stand behind in your next leadership meeting.
        </p>
        <div class="ctas">
          <a class="button" href={CTA.calendly}>Book a call</a>
          <a class="button button--ghost" href={CTA.newsletter}>Subscribe to Cited</a>
        </div>
      </div>
      <div class="hero__cluster" data-cluster>
        <div class="hc__pattern hc__pattern--back" aria-hidden="true"></div>
        <div class="hc__pattern hc__pattern--front" aria-hidden="true"></div>
        <img class="hc__photo" src="/images/hero-portrait.jpg" alt="Laura Seelinger" />
        <!-- locally-sourced sticker pile, top-left (overlapping, varied size/color) -->
        <img class="hc__stk ls ls--a" src="/brand/assets/sticker-locally-sourced.png" alt="" aria-hidden="true" data-cstk data-rot="-10" data-depth="16" style="transform: rotate(-10deg)" />
        <img class="hc__stk ls ls--b" src="/brand/assets/sticker-ls-rust.png" alt="" aria-hidden="true" data-cstk data-rot="9" data-depth="26" style="transform: rotate(9deg)" />
        <img class="hc__stk ls ls--c" src="/brand/assets/sticker-ls-blue.png" alt="" aria-hidden="true" data-cstk data-rot="6" data-depth="14" style="transform: rotate(6deg)" />
        <!-- the other brand stickers, around the photo -->
        <img class="hc__stk hc__stk--tailored" src="/brand/assets/sticker-tailored.png" alt="" aria-hidden="true" data-cstk data-rot="8" data-depth="22" style="transform: rotate(8deg)" />
        <img class="hc__stk hc__stk--organic" src="/brand/assets/sticker-organic.png" alt="" aria-hidden="true" data-cstk data-rot="-7" data-depth="30" style="transform: rotate(-7deg)" />
        <img class="hc__stk hc__stk--feat" src="/brand/assets/sticker-team.png" alt="" aria-hidden="true" data-cstk data-rot="7" data-depth="34" style="transform: rotate(7deg)" />
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="band--marquee section--rust marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...marquee, ...marquee].map((m) => (<><span>{m}</span><span class="marquee__dot">✦</span></>))}
    </div>
  </div>

  <!-- STATS (forest, animated) -->
  <section class="band section--forest">
    <div class="container">
      <div class="measure" data-reveal>
        <h2>AI doesn’t build your brand from your website</h2>
        <p>
          It builds it from the ENTIRE internet — reviews, forums, Reddit threads,
          comparison pages, stuff you didn’t write or approve. You can rank #1 on
          Google and still be invisible in the answer.
        </p>
      </div>
      <div class="stat-source-block" data-reveal>
        <h4 class="stat-source">LSX client results</h4>
        <p class="stat-source-body">In a three-month period, a client in the medical tech industry has</p>
      </div>
      <div class="stat-grid" style="grid-template-columns: repeat(2, 1fr); max-width: 800px; margin-top: 0;">
        <div data-reveal data-reveal-delay="1">
          <div class="stat__num"><span data-count="40" data-suffix="%">40%</span></div>
          <p class="stat__label">in AI Share of Voice; up 16%</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <div class="stat__num"><span data-count="4" data-suffix="×">4×</span></div>
          <p class="stat__label">more AI citations</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOR MARKETING LEADERS — the C-suite translation angle -->
  <section class="band" style="padding-bottom: 0">
    <div class="container">
      <div class="measure" data-reveal>
      <p class="subhead">for marketing leaders</p>
      <h2>Walk into your next leadership meeting with a direction</h2>
      <p>
        Somebody above you has asked about AI search (probably more than once).
        Your team has been figuring it out on top of everything else, and while
        they’ve learned a lot, you’re stuck with figuring out how to position those
        findings into a read that leadership can understand — and approve budget
        for. I’ve spent over 15 years across agency and corporate, including the
        conference rooms where the VP gets eight minutes on the agenda to explain
        the entire marketing strategy. I know how to tell that story truthfully —
        what AI says about the brand today, what’s working and what to fix first —
        and how to credit the work your team already did instead of starting over
        like it never happened.
      </p>
      </div>
    </div>
  </section>

  <!-- WHAT IS AI VISIBILITY — front-loaded definitional answer (DefinedTerm schema) -->
  <section class="band">
    <div class="container" data-reveal>
      <DefinitionBlock
        term="AI visibility"
        definition="AI visibility is whether — and how — AI engines like ChatGPT, Claude, Gemini, Perplexity and Google AI Overviews surface and cite your brand when people ask questions in your category. It’s distinct from search ranking: you can rank well on Google and still be missing, or uncited, in the AI answer itself."
      />
    </div>
  </section>

  <StitchDivider bg="olive" stitch="ivory" />
  <!-- SERVICES (olive textured, numbered grid) -->
  <section class="band tex-olive section--olive">
    <div class="container">
      <div class="measure" data-reveal>
        <p class="subhead">ways to work with me</p>
        <h2>Pick your entry point</h2>
      </div>
      <div class="cards">
        {ENGAGEMENTS.map((e, i) => (
          <a class="card card--link" href={`/services/${e.slug}`} data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <p class="subhead">{e.eyebrow}</p>
            <h3>{e.name}</h3>
            <p>{e.summary}</p>
            <span class="card__go">Learn more →</span>
          </a>
        ))}
      </div>
      <p data-reveal><a class="button button--ghost" href="/services">See all services</a></p>
    </div>
  </section>

  <!-- FULL-BLEED IMAGE BANNER — text over photo -->
  <section class="band media-overlay media-overlay--center banner">
    <img class="bg" src="/images/laura-laptop-wide.jpg" alt="" aria-hidden="true" />
    <div class="container measure measure--center" data-reveal="scale">
      <p class="subhead">the distinction most people don’t understand</p>
      <h2>Being the answer and being the cited source are two different things</h2>
      <p>
        I’ve had clients AI knew cold — but every citation pointed to a directory
        they didn’t control. A few months of foundation work later, their own
        domain became the #1 cited source for their category. You can’t guarantee
        a citation. You CAN load the dice.
      </p>
      <a class="button" href={CTA.calendly}>Let’s load your dice</a>
    </div>
  </section>

  <StitchDivider bg="cream" stitch="rust" />
  <!-- THE LOOP (cream textured, visualized) -->
  <section class="band tex-cream">
    <div class="container">
      <div class="measure" data-reveal style="margin-bottom: var(--space-4)">
        <p class="subhead">the framework</p>
        <h2>The AI Intelligence Loop</h2>
        <p>Most agencies skip to producing content and hope it lands. I run a loop instead, and it compounds.</p>
      </div>
      <div data-reveal>
        <LoopDiagram />
      </div>
    </div>
  </section>

  <StitchDivider bg="cream-deep" stitch="rust" />
  <!-- CITED — split: photo blends into the text half (readable solid bg) -->
  <section class="split-feature">
    <img class="split-feature__img" src="/images/hero-couch.jpg" alt="Laura Seelinger" />
    <div class="container">
      <div class="split-feature__text" data-reveal="left">
        <p class="subhead">my linkedin newsletter</p>
        <h2>Cited</h2>
        <p>
          AI changed how customers find answers. Most brand &amp; agency strategies
          haven’t caught up, and Cited is where I write about what to do about it. Real audits, real numbers, no
          recycled 2024 advice.
        </p>
        <a class="button" href={CTA.newsletter}>Subscribe to Cited</a>
      </div>
    </div>
  </section>

  <StitchDivider bg="forest" stitch="yellow" />
  <!-- FINAL CTA (forest) -->
  <section class="band section--forest">
    <div class="container measure measure--center final" data-reveal="scale">
      <img class="badge" src="/brand/logo/badge-ivory.svg" alt="" aria-hidden="true" width="84" height="84" />
      <p class="subhead">ai visibility &amp; strategy</p>
      <h2>Get cited by {quarter}</h2>
      <p>Get ahead of your competitors by starting now — let’s talk.</p>
      <div class="ctas">
        <a class="button" href={CTA.calendly}>Book a call</a>
        <a class="button button--ghost" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding-block: var(--space-6);
    background:
      linear-gradient(rgba(252, 245, 229, 0.78), rgba(252, 245, 229, 0.78)),
      url('/brand/patterns/pattern-2.jpg') center / 300px repeat,
      var(--cream);
  }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: var(--space-5); align-items: center; min-height: clamp(440px, 60vh, 580px); }
  .hero__text { max-width: 36rem; }
  .hero h1 { font-size: clamp(2.6rem, 1.7rem + 4vw, 5rem); margin-block: var(--space-1) var(--space-2); }
  .hero__h1-sub { display: block; font-size: clamp(1.45rem, 1.05rem + 1.5vw, 2.2rem); line-height: 1.15; color: var(--brown); margin-top: 0.5rem; max-width: 22ch; }
  .hero__lede { font-size: var(--text-lg); max-width: 44ch; margin-bottom: var(--space-3); }

  /* photo + sticker cluster */
  .hero__cluster { position: relative; width: min(430px, 100%); aspect-ratio: 4 / 5; margin-inline: auto; }
  .hc__pattern { position: absolute; border-radius: 22px; box-shadow: var(--shadow-card); }
  /* back layer — blue checker, peeking opposite corner */
  .hc__pattern--back {
    inset: 0 0 12% 14%; transform: rotate(6deg); z-index: 0;
    background: linear-gradient(rgba(163,187,195,0.55), rgba(163,187,195,0.55)), url('/brand/patterns/pattern-2.jpg') center / 220px repeat, var(--blue);
  }
  /* front layer — peach */
  .hc__pattern--front {
    inset: 8% 12% 2% 2%; transform: rotate(-4deg); z-index: 1;
    background: linear-gradient(rgba(255,190,159,0.42), rgba(255,190,159,0.42)), url('/brand/patterns/pattern-5.jpg') center / 220px repeat, var(--peach);
  }
  .hc__photo {
    position: absolute; inset: 3% 9% 0 7%; width: auto; height: 97%; z-index: 2;
    object-fit: cover; border-radius: 18px;
    -webkit-mask-image: radial-gradient(125% 115% at 50% 42%, #000 74%, transparent 100%);
    mask-image: radial-gradient(125% 115% at 50% 42%, #000 74%, transparent 100%);
  }
  .hc__stk { position: absolute; height: auto; z-index: 3; filter: drop-shadow(0 6px 12px rgba(58,42,30,0.25)); will-change: transform; }
  /* locally-sourced pile, top-left — three, overlapping/touching, varied size + color */
  .ls { z-index: 4; }
  .ls--a { top: -7%; left: -7%; width: 92px; }
  .ls--b { top: 8%; left: -11%; width: 66px; z-index: 6; }
  .ls--c { top: 6%; left: 9%; width: 56px; z-index: 5; }
  /* opposite corner: a second small cluster (balances the pile diagonally),
     pushed to the edge so it's off Laura's body */
  .hc__stk--feat { bottom: -7%; right: -8%; width: 112px; z-index: 4; }
  .hc__stk--tailored { bottom: 14%; right: -12%; width: 72px; z-index: 5; }
  /* top-right: a single accent */
  .hc__stk--organic { top: -6%; right: -7%; width: 86px; }

  .ctas { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }

  .band { padding-block: var(--space-6); }
  .band--marquee { padding-block: var(--space-2); }
  .measure { max-width: 44rem; }
  .measure--center { margin-inline: auto; text-align: center; }
  .measure--center .ctas { justify-content: center; }
  .cite { font-size: 0.82em; opacity: 0.85; }
  .stat-source-block { margin: var(--space-4) 0 var(--space-1); }
  .stat-source {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--amber);
    margin: 0;
  }
  .stat-source-body {
    font-size: var(--text-sm);
    opacity: 0.85;
    margin: var(--space-1) 0 0;
    max-width: none;
  }

  .banner { min-height: 60vh; display: flex; align-items: center; }

  /* Service cards — responsive auto-fit grid (3–4 across) */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-3); margin-block: var(--space-4); }
  .card {
    background: var(--cream); color: var(--brown);
    border-radius: 16px; padding: var(--space-3);
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover { transform: translateY(-6px); box-shadow: var(--shadow-soft); }
  .card--link { text-decoration: none; display: flex; flex-direction: column; }
  .card h3 { margin: 0.2rem 0 0.4rem; color: var(--rust); }
  .card p { margin-bottom: var(--space-2); color: var(--brown); }
  .card__go { margin-top: auto; color: var(--olive); font-weight: 600; font-size: var(--text-sm); }

  /* Cited — feature split: image fills the right half and feathers into the
     solid (readable) left half where the text lives. */
  .split-feature {
    position: relative;
    overflow: hidden;
    background: var(--cream-deep);
  }
  .split-feature__img {
    position: absolute; top: 0; right: 0;
    width: 50%; height: 100%;
    object-fit: cover; object-position: center 30%;
    -webkit-mask-image: linear-gradient(to left, #000 58%, transparent 100%);
    mask-image: linear-gradient(to left, #000 58%, transparent 100%);
  }
  .split-feature .container { position: relative; z-index: 2; }
  .split-feature__text {
    max-width: 44ch;
    padding-block: var(--space-6);
  }

  .final .badge { margin: 0 auto var(--space-2); }

  @media (max-width: 820px) {
    .hero__grid { grid-template-columns: 1fr; min-height: 0; gap: var(--space-4); }
    .hero__text { max-width: none; }
    /* Hide the photo/sticker cluster on the stacked layout so the headline
       leads on mobile (it was appearing above the H1 and crowding the top). */
    .hero__cluster { display: none; }
  }
  @media (max-width: 760px) {
    .split-feature__img {
      position: relative; width: 100%; height: 260px;
      -webkit-mask-image: linear-gradient(to top, #000 62%, transparent 100%);
      mask-image: linear-gradient(to top, #000 62%, transparent 100%);
    }
    .split-feature__text { padding-block: var(--space-4); }
  }
</style>

<script>
  // Hero cluster stickers drift gently with scroll (subtle parallax).
  const cstks = Array.from(document.querySelectorAll<HTMLElement>('[data-cstk]'));
  if (cstks.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const onScroll = () => {
      const vh = window.innerHeight;
      cstks.forEach((s) => {
        const rect = s.getBoundingClientRect();
        const prog = (vh / 2 - (rect.top + rect.height / 2)) / vh;
        const rot = Number(s.dataset.rot || 0);
        const depth = Number(s.dataset.depth || 20);
        s.style.transform = `translateY(${(prog * depth).toFixed(1)}px) rotate(${rot}deg)`;
      });
    };
    onScroll();
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { onScroll(); ticking = false; });
    }, { passive: true });
  }
</script>
