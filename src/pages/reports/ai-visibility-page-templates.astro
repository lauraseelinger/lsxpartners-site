.tp-mk-foot b{color:#444;display:block;margin-bottom:3px;font-size:10px;letter-spacing:.04em;text-transform:uppercase}
.tp-mk-add{outline:2px solid var(--accent);outline-offset:3px;border-radius:7px;position:relative}
.tp-mk-add::before{content:"ADD";position:absolute;top:-9px;left:9px;background:var(--accent);color:#fff;font-size:7.5px;font-weight:800;letter-spacing:.05em;padding:1px 6px;border-radius:3px;z-index:2}
.tp-mk-hid{outline:2px dashed #1d4ed8;outline-offset:3px;border-radius:7px;position:relative}
.tp-mk-hid::before{content:"INVISIBLE ON THE PAGE";position:absolute;top:-9px;left:9px;background:#1d4ed8;color:#fff;font-size:7.5px;font-weight:800;letter-spacing:.05em;padding:1px 6px;border-radius:3px;z-index:2}
table.tp-map{border-collapse:collapse;width:100%;font-size:13px;margin:10px 0}
table.tp-map th,table.tp-map td{border:1px solid var(--line);padding:10px 12px;text-align:left;vertical-align:top}
table.tp-map th{background:var(--forest);color:#fff;font-weight:700;font-size:12px;letter-spacing:.03em}
