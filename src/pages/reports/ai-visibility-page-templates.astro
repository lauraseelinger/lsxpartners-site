.tp-eco{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin:10px 0}
.tp-eco .tp-n{border:1px solid var(--line);background:#fffdf7;border-radius:9px;padding:10px 11px;font-size:11.5px;line-height:1.45}
.tp-eco .tp-n b{display:block;font-size:11px;margin-bottom:4px;color:#1a1a1a}
.tp-eco .tp-n.tp-g{border-color:#c9caa0;background:#f7f7ea}
.tp-callout{background:var(--cream-deep);border:1px solid var(--tan);border-left:3px solid var(--add);border-radius:9px;padding:12px 15px;font-size:12.8px;margin:12px 0;line-height:1.55}
.tp-callout b{color:var(--accent)}
@media(max-width:820px){.tp-mk-row{grid-template-columns:1fr}.tp-mk-cards{grid-template-columns:1fr 1fr}.tp-eco{grid-template-columns:1fr 1fr}table.tp-map td:first-child{width:auto}}

.tp-reflist{display:grid;grid-template-columns:1fr 1fr;gap:0 22px;margin:8px 0 0;padding:0;list-style:none;counter-reset:ri}
