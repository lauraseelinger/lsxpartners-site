.tp-mk-tbl{width:100%;border-collapse:collapse;font-size:11px;margin:8px 0}
.tp-mk-tbl td,.tp-mk-tbl th{border:1px solid var(--line);padding:7px 9px;text-align:left}.tp-mk-tbl th{background:#faf7f5;font-weight:700}
.tp-mk-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.tp-mk-swatch{display:flex;gap:7px;margin:9px 0}.tp-mk-swatch i{width:20px;height:20px;border-radius:50%;border:1px solid #bbb;display:inline-block}
