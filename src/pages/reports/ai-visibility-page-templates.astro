<BaseLayout title={title} description={description} type="article">
  <Fragment set:html={reportHtml} />
</BaseLayout>

<script is:inline>
function showTab(i,el){
  document.querySelectorAll('.tp-panel').forEach(function(p,n){p.classList.toggle('tp-active',n===i)});
  document.querySelectorAll('.tp-tab').forEach(function(t){t.classList.remove('tp-active')});
  el.classList.add('tp-active');
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>

<style is:global>
.tp-wrap{font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;color:var(--ink);--ink:#483729;--muted:#7a6550;--line:#e7d8b8;--bg:#fcf5e5;--card:#fff;--accent:#b55434;--add:#d39000;--win:#8b8c4a;--cream-deep:#faeccd;--forest:#21362c;--peach:#ffbe9f;--tan:#e7d8b8}
*{box-sizing:border-box}
.tp-wrap{max-width:1120px;margin:0 auto;padding:30px 26px 80px}
h1{font-size:24px;margin:0 0 4px;letter-spacing:-.01em}
.tp-sub{color:var(--muted);font-size:13.5px;margin:0 0 18px;max-width:900px}
.tp-sub a{color:var(--accent);font-weight:600;text-decoration:underline;text-decoration-color:#e0c4b6;text-underline-offset:2px}
.tp-sub a:hover{text-decoration-color:var(--accent)}
.tp-tabs{display:flex;gap:4px;border-bottom:2px solid var(--line);margin:0 0 22px;flex-wrap:wrap}
.tp-tab{padding:11px 14px;font-weight:700;font-size:13px;color:#888;cursor:pointer;border:0;background:none;border-bottom:3px solid transparent;margin-bottom:-2px;display:flex;gap:7px;align-items:center}
.tp-tab:hover{color:var(--ink)}.tp-tab.tp-active{color:var(--accent);border-bottom-color:var(--accent)}
.tp-tab .tp-n{display:inline-flex;width:19px;height:19px;border-radius:50%;background:var(--cream-deep);color:var(--muted);font-size:10.5px;align-items:center;justify-content:center;font-weight:800}
.tp-tab.tp-active .tp-n{background:var(--accent);color:#fff}
.tp-panel{display:none;animation:fade .2s ease}.tp-panel.tp-active{display:block}
@keyframes fade{from{opacity:.3}to{opacity:1}}
.tp-lead-h{background:var(--forest);color:#fff;border-radius:12px;padding:15px 19px;margin:0 0 16px}
.tp-lead-h .tp-k{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--peach);font-weight:700}
.tp-lead-h .tp-t{font-size:17px;font-weight:700;margin:4px 0 6px;letter-spacing:-.01em}
.tp-lead-h .tp-d{font-size:13.5px;color:#dfe8e2}
.tp-lead-h .tp-q{background:#2b4539;border-left:3px solid var(--peach);border-radius:0 7px 7px 0;padding:8px 12px;margin:10px 0 0;font-size:13px;color:#fff}
.tp-seclabel{font:800 12px/1 -apple-system,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin:26px 0 9px}
.tp-acard{border:1px solid var(--line);border-left:3px solid var(--accent);background:#fffdf7;border-radius:9px;padding:13px 15px;font-size:13px;margin:0 0 12px}
.tp-acard b{color:#1a1a1a}
.tp-fine{font-size:11.5px;color:var(--muted);margin:6px 0 0}
.tp-note{color:var(--muted);font-size:12px;margin-top:22px}
.tp-code{background:#f7f1e3;border:1px solid var(--line);border-radius:6px;padding:10px 12px;font:11px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;color:#1a1a1a;white-space:pre-wrap;overflow-x:auto;margin:7px 0}
.tp-mock-cap{font-size:11px;color:var(--muted);margin:16px 0 7px;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.tp-keybar{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;font-size:11.5px;background:#fffdf7;border:1px solid var(--line);border-radius:9px;padding:10px 13px;margin:0 0 16px}
.tp-kdot{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:middle}
.tp-pin{display:inline-flex;align-items:center;justify-content:center;width:19px;height:19px;border-radius:50%;background:var(--accent);color:#fff;font-size:10.5px;font-weight:800;vertical-align:middle;flex:none;margin-right:7px;font-style:normal}
.tp-anno{background:#fffdf7;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:8px;padding:9px 12px;font-size:12.5px;margin:8px 0;display:flex;gap:10px;align-items:baseline;line-height:1.5}
.tp-anno .tp-pn{flex:none;width:19px;height:19px;border-radius:50%;background:var(--accent);color:#fff;font-size:10.5px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;margin-top:1px}
.tp-anno .tp-eye{display:block;font-size:11px;font-weight:800;letter-spacing:.01em;color:var(--accent);margin:0 0 3px}
.tp-ref{display:inline-block;margin-left:7px;font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#a2887b;white-space:nowrap}
.tp-anno .tp-deck{display:inline-block;font-size:9px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;background:#f1ece9;color:#8a4327;border:1px solid #e3d5cd;border-radius:4px;padding:1px 6px;margin-right:6px;vertical-align:1px}
.tp-anno .tp-off{background:#eaf0ff;color:#1d4ed8;border-color:#c9d6f5}
/* page-mock frame */
.tp-frame{background:var(--tan);border:1px solid #d8c49c;border-radius:14px;padding:13px 16px 14px;margin:16px 0 8px;box-shadow:inset 0 1px 3px rgba(0,0,0,.05)}
.tp-frame-lbl{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 2px 10px}
.tp-frame-lbl b{font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
.tp-frame-lbl span{font-size:10.5px;color:var(--muted)}
.tp-frame-end{text-align:center;font-size:9.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin:11px 0 0}
.tp-mk-bar{background:#dbdbdb;border-bottom:1px solid #c4c4c4;padding:7px 12px;display:flex;align-items:center;gap:6px}
.tp-mk-bar i{width:9px;height:9px;border-radius:50%;display:inline-block;background:#bcbcbc;flex:none}
.tp-mk-bar .tp-url{flex:1;background:#fff;border:1px solid #c9c9c9;border-radius:20px;font:9.5px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;color:#8d8d8d;padding:3px 11px;margin-left:7px;overflow:hidden;white-space:nowrap}
/* page mock */
.tp-mk{border:1px solid #ccc;border-radius:10px;overflow:hidden;margin:10px 0;box-shadow:0 6px 22px rgba(0,0,0,.13)}
.tp-mk-nav{background:#111;color:#fff;display:flex;align-items:center;gap:13px;padding:9px 14px;font-size:11px}
.tp-mk-nav .tp-lg{font-weight:800;font-size:14px;letter-spacing:-.01em}.tp-mk-nav .tp-sp{flex:1}.tp-mk-nav .tp-it{color:#ccc}
.tp-mk-crumb{background:#fafafa;border-bottom:1px solid var(--line);padding:6px 14px;font-size:10.5px;color:#999}
.tp-mk-body{padding:18px;background:#fff}
.tp-mk-h1{font-size:21px;font-weight:800;margin:2px 0 6px}
.tp-mk-byline{font-size:10.5px;color:#777;border-bottom:1px solid var(--line);padding-bottom:9px;margin-bottom:4px}
.tp-mk-byline b{color:#333}
.tp-mk-h{font-size:12px;font-weight:800;letter-spacing:.02em;color:#222;margin:18px 0 9px;border-top:2px solid #111;padding-top:9px}
.tp-mk-ans{background:#fff7d6;border:1px solid #e6cf63;border-radius:7px;padding:14px 15px;font-size:12px;color:#5a4a00;margin:12px 0}
.tp-mk-ans b.tp-lbl{display:block;margin-bottom:5px;font-size:10.5px;text-transform:uppercase;letter-spacing:.04em}
.tp-mk-fpo{background:repeating-linear-gradient(45deg,#eee,#eee 9px,#e6e6e6 9px,#e6e6e6 18px);border:1px solid #dbdbdb;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#999;font-size:10px;font-weight:700;letter-spacing:.04em;text-align:center;padding:8px;min-height:108px}
.tp-mk-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.tp-mk-line{height:7px;background:#e9e9e9;border-radius:3px;margin:6px 0}.tp-mk-line.tp-s{width:78%}.tp-mk-line.tp-xs{width:52%}
.tp-mk-acc div{border:1px solid var(--line);border-bottom:0;padding:11px 12px;font-size:12px;font-weight:600;display:flex;justify-content:space-between;color:#333}
